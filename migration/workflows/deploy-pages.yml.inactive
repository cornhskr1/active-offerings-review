name: Deploy Active Offerings Review

on:
  push:
    branches: [main]
  workflow_dispatch:
    inputs:
      resume_after_review:
        description: 'Resume only after reviewing a failed deployment for unexpected API usage'
        type: boolean
        default: false
  schedule:
    - cron: "17 */3 * * *"
  workflow_run:
    workflows:
      - Refresh Approved Sports Schedule
      - Update NRGC Catalog
      - Refresh Priority Queue
      - Refresh Catalog Change Queue
      - Refresh Nebraska Collegiate
      - Refresh Licensed F1 Schedule
      - Refresh public data
      - Refresh Tennis Intelligence
      - Deep Tennis Age Scan
      - Refresh NCAA Football
      - Refresh NCAA Basketball
      - Refresh NCAA Basketball Rosters
    types: [completed]

permissions:
  contents: read
  actions: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  deploy:
    if: ${{ github.ref == 'refs/heads/main' && (github.event_name != 'workflow_run' || github.event.workflow_run.conclusion == 'success') }}
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Checkout latest main
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: main
          fetch-depth: 1
      - uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7.1.0
        with:
          python-version: '3.12'
      - name: Verify previous deployment before any provider collection
        env:
          GH_TOKEN: ${{ github.token }}
          RESUME_AFTER_REVIEW: ${{ inputs.resume_after_review || false }}
        run: python scripts/check_odds_deploy_safety.py
      - name: Stage site with pinned verified-cache recovery
        id: stage
        env:
          GH_TOKEN: ${{ github.token }}
          DATA_REPO_READ_TOKEN: ${{ secrets.DATA_REPO_READ_TOKEN }}
        run: python -m scripts.restore_public_snapshot --root . --stage "$RUNNER_TEMP/active-offerings-site" --previous "$RUNNER_TEMP/odds-previous.json" --checkpoint migration/activation/pages-bootstrap.json
      - name: Refresh zero-quota event observations only
        if: steps.stage.outputs.recovered != 'true'
        env:
          ODDS_API_KEY: ${{ secrets.ODDS_API_KEY }}
        run: python scripts/refresh_odds_api_events.py --config data/odds-api-catalog-mappings.json --previous "$RUNNER_TEMP/odds-previous.json" --output "$RUNNER_TEMP/active-offerings-site/data/odds-api-events.json"
      - uses: actions/configure-pages@45bfe0192ca1faeb007ade9deae92b16b8254a0d # v6.0.0
      - uses: actions/upload-pages-artifact@fc324d3547104276b827a68afc52ff2a11cc49c9 # v5.0.0
        with:
          path: ${{ runner.temp }}/active-offerings-site
          retention-days: 1
      - id: deployment
        uses: actions/deploy-pages@368f82528645a54fb793d4d04e342629a3f51346 # v5.0.1
